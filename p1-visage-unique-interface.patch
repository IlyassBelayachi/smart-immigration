+.decide { background: var(--apricot); border-radius: 16px; padding: 1rem; margin-top: .8rem; }
+.facts-list { display: grid; gap: .6rem; margin: 0 0 1rem; }
+.facts-list div { display: flex; gap: 1rem; border-bottom: 1px solid var(--line); padding-bottom: .5rem; }
+.facts-list dt { width: 8rem; color: var(--ink-soft); } .facts-list dd { margin: 0; font-weight: 600; }
+
+/* Suivi d'une demande */
+.track { margin: .6rem 0 1rem; }
+.track-line { height: 6px; background: var(--line); border-radius: 3px; overflow: hidden; }
+.track-fill { display: block; height: 100%; background: linear-gradient(90deg, var(--berry), var(--amber)); transform-origin: left; }
+.track.s-approved .track-fill { background: var(--green); }
+.track.s-rejected .track-fill { background: var(--red); }
+.track ol { list-style: none; display: flex; justify-content: space-between; margin: .4rem 0 0; padding: 0; font-size: .85rem; color: var(--ink-soft); }
+.track li.reached { color: var(--ink); font-weight: 700; }
+
+/* Avis de l'assistant */
+.rec { background: var(--blush); border-radius: 16px; padding: .9rem 1rem; margin: .6rem 0; }
+.rec ul { list-style: none; margin: .5rem 0 0; padding: 0; display: grid; gap: .5rem; }
+.badge { display: inline-block; font-size: .78rem; font-weight: 700; border-radius: 999px; padding: .1rem .6rem; background: #fff; border: 1px solid var(--line); margin-right: .3rem; }
+.v-fail .badge { background: var(--red-bg); color: var(--red); border-color: transparent; }
+.v-pass .badge { background: var(--green-bg); color: var(--green); border-color: transparent; }
+
+@media (max-width: 720px) {
+  .role-grid, .grid2 { grid-template-columns: 1fr; }
+  .counts { grid-template-columns: repeat(2, 1fr); }
+  .who span { display: none; }
+  .panel { padding: 1.1rem; border-radius: 20px; }
+  .stepper li { font-size: .8rem; }
+  .subnav { overflow-x: auto; }
+}
+@media (prefers-reduced-motion: reduce) {
+  *, *::before, *::after { animation: none !important; transition: none !important; }
+}
diff --git a/frontend-app/src/usePanelMotion.js b/frontend-app/src/usePanelMotion.js
new file mode 100644
index 0000000..927d9da
--- /dev/null
+++ b/frontend-app/src/usePanelMotion.js
@@ -0,0 +1,19 @@
+import gsap from "gsap";
+import { useGSAP } from "@gsap/react";
+import { D, EASE, reduced } from "./motion.js";
+
+gsap.registerPlugin(useGSAP);
+
+// Répond à une action de la personne : le nouveau panneau glisse en place. `key` change => on rejoue.
+export const usePanelMotion = (scope, key, fromX = 24) =>
+  useGSAP(() => {
+    if (reduced()) return;
+    gsap.from(".panel", { x: fromX, opacity: 0, duration: D.base, ease: EASE.out });
+  }, { scope, dependencies: [key] });
+
+// Arrivée des blocs d'une vue, une seule fois.
+export const useEnter = (scope, selector, deps = []) =>
+  useGSAP(() => {
+    if (reduced()) return;
+    gsap.from(selector, { opacity: 0, y: 18, duration: D.base, stagger: 0.07, ease: EASE.out });
+  }, { scope, dependencies: deps });
