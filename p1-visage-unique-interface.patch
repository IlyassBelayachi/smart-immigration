+button.danger { color: var(--red); border-color: #efb9bb; }
+button.link { background: none; border: 0; padding: .3rem 0; color: var(--rose); text-decoration: underline; text-underline-offset: 3px; font-weight: 600; }
+.filebtn { display: inline-block; margin: .5rem 0 1rem; border: 1.5px dashed var(--rose); color: var(--rose); border-radius: 12px; padding: .75rem 1.2rem; font-weight: 600; cursor: pointer; }
+.filebtn:focus-within { outline: 3px solid var(--amber); outline-offset: 2px; }
+label { display: block; font-weight: 600; margin-bottom: 1rem; }
+input, select, textarea { display: block; width: 100%; margin-top: .35rem; font: 400 1rem var(--body); color: var(--ink); background: #fff;
+  border: 1.5px solid var(--line); border-radius: 10px; padding: .65rem .8rem; }
+input:focus, select:focus, textarea:focus { outline: none; border-color: var(--rose); box-shadow: 0 0 0 3px #f9c5d4; }
+.row { display: flex; flex-wrap: wrap; gap: .7rem; margin-top: .5rem; }
+.row.center { justify-content: center; }
+.grid2 { display: grid; grid-template-columns: repeat(2, 1fr); gap: 0 1rem; }
+.error { color: var(--red); background: var(--red-bg); border-radius: 10px; padding: .6rem .8rem; }
+.ok { color: var(--green); background: var(--green-bg); border-radius: 10px; padding: .6rem .8rem; }
+.notice { background: var(--warn-bg); border-radius: 14px; padding: .8rem 1rem; margin-bottom: 1rem; }
+.notice ul { margin: .4rem 0 0; padding-left: 1.2rem; }
+.chip { display: inline-block; font-size: .85rem; font-weight: 700; border-radius: 999px; padding: .15rem .7rem; margin-right: .5rem; }
+.chip.ok { background: var(--green-bg); color: var(--green); }
+
+/* Panneaux */
+.panel { background: #fff; border: 1px solid var(--line); border-radius: 24px; padding: 1.6rem; box-shadow: 0 18px 40px -28px rgba(175, 39, 79, .45); }
+.panel.success { text-align: center; }
+.panel.success p { margin-inline: auto; }
+
+/* Accueil */
+.home { padding-top: 1.5rem; }
+.home h1 { max-width: 16ch; }
+.mask { display: block; overflow: hidden; padding-bottom: .12em; }
+.hl { display: block; }
+.hl-soft { color: var(--rose); }
+.home-intro { font-size: 1.1rem; color: var(--ink-soft); margin: 1.1rem 0 2rem; }
+.role-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 1.25rem; }
+.role-card { position: relative; text-align: left; padding: 3px; border: 0; border-radius: 28px; background: var(--line); cursor: pointer; isolation: isolate; }
+.role-card::before { content: ""; position: absolute; inset: 0; border-radius: inherit; z-index: -2; opacity: 0; transition: opacity .3s;
+  background: conic-gradient(from var(--edge-angle), var(--edge), transparent 30%, var(--edge) 55%, transparent 80%, var(--edge)); }
+.role-card:hover::before, .role-card:focus-visible::before { opacity: 1; animation: spin 3.2s linear infinite; }
+.role-card.candidate { --edge: var(--berry); --card: var(--blush); }
+.role-card.consultant { --edge: var(--amber); --card: var(--apricot); }
+.role-body { display: flex; flex-direction: column; gap: .6rem; background: var(--card); border-radius: 25px; padding: 1.8rem 1.6rem; min-height: 14rem; }
+.role-body strong { font: 800 1.9rem var(--display); letter-spacing: -0.02em; }
+.role-go { margin-top: auto; font-weight: 700; color: var(--rose); }
+.role-card:hover .role-go { text-decoration: underline; text-underline-offset: 4px; }
+@keyframes spin { to { --edge-angle: 360deg; } }
+.facts { list-style: none; padding: 0; margin: 3rem 0 0; display: grid; gap: .5rem; color: var(--ink-soft); }
+.facts li { padding-left: 1.4rem; position: relative; }
+.facts li::before { content: ""; position: absolute; left: 0; top: .6em; width: .6rem; height: .6rem; border-radius: 50%; background: var(--amber); }
+
+/* Authentification */
+.auth { max-width: 600px; margin: 0 auto; }
+.auth.consultant .tabs .on, .auth.consultant .primary { --accent: var(--amber); }
+.auth-title { font-size: clamp(1.6rem, 4vw, 2.2rem); }
+.back { margin-bottom: .6rem; }
+.auth-body { display: grid; gap: 1rem; }
+.tabs, .subnav { display: flex; gap: .4rem; background: var(--blush); border-radius: 999px; padding: .3rem; margin-bottom: 1.3rem; width: fit-content; max-width: 100%; }
