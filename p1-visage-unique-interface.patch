+.tabs .on, .subnav .on { background: #fff; color: var(--rose); box-shadow: 0 2px 8px -3px rgba(53, 32, 32, .3); }
+.cin-preview { display: block; max-width: 100%; max-height: 220px; border-radius: 14px; border: 1px solid var(--line); margin: .6rem 0; }
+
+/* Étapes */
+.stepper { position: relative; padding-bottom: 1.2rem; }
+.stepper ol { list-style: none; display: flex; justify-content: space-between; margin: 0; padding: 0; counter-reset: s; }
+.stepper li { flex: 1; font-weight: 600; color: var(--ink-soft); padding-top: .7rem; font-size: .95rem; }
+.stepper li.now { color: var(--rose); } .stepper li.done { color: var(--ink); }
+.steps-track { position: absolute; left: 0; right: 0; top: 0; height: 5px; background: var(--line); border-radius: 3px; overflow: hidden; }
+.steps-fill { display: block; height: 100%; background: linear-gradient(90deg, var(--berry), var(--amber)); transform-origin: left; transform: scaleX(0); }
+
+/* Scan du visage */
+.scan { display: grid; gap: .8rem; justify-items: center; }
+.scan-frame { position: relative; width: min(300px, 80vw); aspect-ratio: 1; }
+.scan-video { position: absolute; inset: 14px; border-radius: 50%; overflow: hidden; background: #2a1a1a radial-gradient(circle at 50% 40%, #4a3333, #241616); }
+.scan-video video { width: 100%; height: 100%; object-fit: cover; display: block; }
+.mirror { transform: scaleX(-1); }
+.ring { position: absolute; inset: 0; width: 100%; height: 100%; }
+.ring-track { fill: none; stroke: var(--line); stroke-width: 6; }
+.ring-progress { fill: none; stroke: var(--rose); stroke-width: 8; stroke-linecap: round; }
+.scan-frame.on .ring-track { stroke: #f4bfcf; }
+.count { position: absolute; inset: 0; display: grid; place-items: center; font: 800 5rem var(--display); color: #fff; text-shadow: 0 2px 18px rgba(0, 0, 0, .5); }
+.flash { position: absolute; inset: 0; background: #fff; opacity: 0; pointer-events: none; }
+.scan-tip { text-align: center; color: var(--ink-soft); max-width: 40ch; margin: 0; }
+
+/* Candidat et consultant */
+.welcome h1 { font-size: clamp(1.8rem, 4vw, 2.6rem); }
+.counts { align-items: stretch; display: grid; grid-template-columns: repeat(5, 1fr); gap: .8rem; margin: 1.2rem 0; }
+.count-card { text-align: left; border-radius: 18px; background: var(--apricot); border-color: transparent; display: grid; gap: .1rem; padding: .9rem 1rem; }
+.count-card strong { font: 800 1.9rem var(--display); }
+.count-card span { font-size: .85rem; color: var(--ink-soft); }
+.count-card.on { background: #fff; border-color: var(--amber); }
+.req { border-top: 1px solid var(--line); padding: 1.1rem 0; }
